# Copy this file to .env.local and fill in your real key.
# .env.local is git-ignored. NEVER put NEXT_PUBLIC_ in front of these names.

# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model name. Check Google AI Studio docs for the current list; names change over time.
GEMINI_MODEL=gemini-2.5-flash

# Safety limits
MAX_OUTPUT_TOKENS=4000
RATE_LIMIT_PER_MINUTE=5
